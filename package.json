{
  "name": "hanzi-master",
  "version": "5.2.61",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-runtime.mjs",
    "build": "node scripts/prepare-site-url.mjs && next build && node scripts/check-bundle-size.mjs",
    "start": "next start",
    "typecheck": "node scripts/temp-paths.mjs && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "node scripts/run-tests.mjs",
    "check:lines": "node scripts/check-line-count.mjs",
    "check:root": "node scripts/check-root-clean.mjs",
    "check:csp": "node scripts/check-csp-consistency.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "analyze": "node scripts/analyze.mjs",
    "i18n:lint": "node scripts/i18n-lint.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "prototype:parity": "node scripts/prototype-parity.mjs",
    "clean:tmp": "node scripts/clean-temp.mjs",
    "clean:cache": "node scripts/clean-temp.mjs --cache",
    "clean:log": "node scripts/clean-temp.mjs --log",
    "clean:all": "node scripts/clean-temp.mjs --all",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{ts,mjs,js}\" \"prototype/scripts/**/*.js\" \"prototype/styles/**/*.css\"",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "security:audit:dev": "pnpm audit --audit-level=high",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@sentry/nextjs": "11.11.0",
    "@vercel/blob": "2.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.76.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/bundle-analyzer": "16.4.6",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitest/coverage-v8": "5.1.1",
    "autoprefixer": "10.7.0",
    "eslint": "10.15.0",
    "jsdom": "30.1.3",
    "postcss": "8.5.15",
    "prettier": "3.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "24.11.0",
    "pnpm": ">=11"
  }
}
